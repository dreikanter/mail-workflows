#!/usr/bin/env ruby
# frozen_string_literal: true

# Syncs mail from IMAP and normalizes new messages into LLM-ready markdown.
#
# Steps:
#   1. Generate .mbsyncrc from accounts.yml and ensure Maildir directories exist
#   2. Run mbsync to pull new mail
#   3. Normalize new messages (extract body, attachments, write markdown)
#
# Usage: bin/sync [--home DIR] [--verbose]

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "log"
require "mbsyncrc_generator"
require "maildir_store"
require "normalizer"

# --- Parse arguments ---

home = ENV.fetch("MAIL_WORKFLOWS_HOME", File.expand_path("~/.mail-workflows"))
verbose = false

args = ARGV.dup
while args.any?
  case args.shift
  when "--home" then home = args.shift
  when "--verbose", "-v" then verbose = true
  else
    $stderr.puts "Usage: sync [--home DIR] [--verbose]"
    exit 1
  end
end

level = verbose ? Logger::DEBUG : Logger::INFO
log = MailWorkflows.create_logger(level: level, home: home)

# --- Step 1: Generate .mbsyncrc and prepare Maildir ---

rc_path = MailWorkflows::MbsyncrcGenerator.new(home, logger: log).run
log.info "generated #{rc_path}"

# --- Step 2: Run mbsync ---

rc_file = File.join(home, ".mbsyncrc")
log.info "running mbsync"
system("mbsync", "-c", rc_file, "-a", exception: true)
log.info "mbsync complete"

# --- Step 3: Normalize new messages ---

store = MailWorkflows::MaildirStore.new(home)
normalizer = MailWorkflows::Normalizer.new(home, logger: log)

count = 0
errors = 0

store.each_new_message do |filepath, maildir, account, folder|
  result = normalizer.normalize(filepath, account: account, folder: folder)
  if result
    maildir.mark_processed(filepath)
    count += 1
  end
rescue StandardError => e
  errors += 1
  log.error "failed to normalize #{File.basename(filepath)}: #{e.message}"
  log.debug e.backtrace.first(5).join("\n")
end

log.info "done: #{count} normalized, #{errors} errors"
