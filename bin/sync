#!/usr/bin/env ruby
# frozen_string_literal: true

# Syncs mail from IMAP and normalizes new messages into LLM-ready markdown.
#
# Steps:
#   1. Generate .mbsyncrc from accounts.yml and ensure Maildir directories exist
#   2. Run mbsync to pull new mail
#   3. Normalize new messages (extract body, attachments, write markdown)
#
# Usage: bin/sync [--home DIR]

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "mbsyncrc_generator"
require "maildir_store"
require "normalizer"

# --- Parse arguments ---

home = ENV.fetch("MAIL_WORKFLOWS_HOME", File.expand_path("~/.mail-workflows"))

args = ARGV.dup
while args.any?
  case args.shift
  when "--home" then home = args.shift
  else
    $stderr.puts "Usage: sync [--home DIR]"
    exit 1
  end
end

# --- Step 1: Generate .mbsyncrc and prepare Maildir ---

$stderr.puts "Generated #{MailWorkflows::MbsyncrcGenerator.new(home).run}"
$stderr.puts "Maildir directories ready"

# --- Step 2: Run mbsync ---

$stderr.puts "Syncing mail..."
system("mbsync", "-c", File.join(home, ".mbsyncrc"), "-a", exception: true)
$stderr.puts "Sync complete."

# --- Step 3: Normalize new messages ---

store = MailWorkflows::MaildirStore.new(home)
normalizer = MailWorkflows::Normalizer.new(home)

count = 0
errors = 0

store.each_new_message do |filepath, maildir, account, folder|
  result = normalizer.normalize(filepath, account: account, folder: folder)
  if result
    maildir.mark_processed(filepath)
    count += 1
    name = File.basename(result.path)
    $stderr.puts "normalized: #{name}"
    $stderr.puts "  from: #{result.from}"
    $stderr.puts "  message-id: #{result.message_id}"
    unless result.attachments.empty?
      result.attachments.each { |a| $stderr.puts "  attachment: #{a}" }
    end
  end
rescue StandardError => e
  errors += 1
  $stderr.puts "WARN: failed to normalize #{File.basename(filepath)}: #{e.message}"
end

$stderr.puts "Done: #{count} normalized, #{errors} errors"
