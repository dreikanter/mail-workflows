#!/usr/bin/env bash
set -euo pipefail

# Debug helper: delete all Maildir, normalized, and attachment data.
# Does NOT touch accounts.yml, rules, or prompts.

usage() {
  echo "Usage: purge [--home DIR]" >&2
  echo "  --home DIR  Data directory (default: \$MAIL_WORKFLOWS_HOME or ~/.mail-workflows)" >&2
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --home) MAIL_WORKFLOWS_HOME="$2"; shift 2 ;;
    *) usage ;;
  esac
done

MAIL_WORKFLOWS_HOME="${MAIL_WORKFLOWS_HOME:-${HOME}/.mail-workflows}"

DIRS=(
  "$MAIL_WORKFLOWS_HOME/mail"
  "$MAIL_WORKFLOWS_HOME/normalized"
  "$MAIL_WORKFLOWS_HOME/attachments"
)

for dir in "${DIRS[@]}"; do
  if [[ -d "$dir" ]]; then
    echo "removing $dir" >&2
    rm -rf "$dir"
  fi
done

echo "purge complete" >&2
